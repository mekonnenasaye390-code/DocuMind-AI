# Copy this file to .env and fill it in.  (cp .env.example .env)

# --- AI provider: "gemini" (Google), "anthropic" (Claude API) or "ollama" (local) ---
LLM_PROVIDER=gemini

# Gemini (when LLM_PROVIDER=gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_THINKING_BUDGET=0       # optional; 0 turns hidden "thinking" off (default for 2.5-flash)

# Anthropic (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_NUM_CTX=8192

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
# Required in production: a long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set both to true when served over HTTPS behind nginx / a load balancer
COOKIE_SECURE=false
TRUST_PROXY=false

# --- Optional tuning (defaults shown) -----------------------------------------
# MAX_UPLOAD_MB=10
# MAX_PAGES=100
# SESSION_TTL_MINUTES=120
# MAX_SESSIONS=200
# RATE_LIMIT_PER_MIN=20
# UPLOAD_LIMIT_PER_MIN=6
# TOP_K=6
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# CHAT_FULL_CONTEXT_CHARS=12000
# CONTEXT_CHAR_BUDGET=60000      # text sent for summaries/exams (16000 for ollama)
# LLM_MAX_TOKENS=1200
# LLM_TIMEOUT_SECONDS=90
# LOG_LEVEL=INFO
